<?xml version="1.0" encoding="utf-8"?>
<!--
    LATAR BELAKANG KOTAK UPLOAD
    Kotak dengan garis tepi putus-putus (dash), supaya pengguna langsung paham
    bahwa area ini bisa diketuk untuk memasukkan gambar.
    - dashWidth = panjang tiap garis
    - dashGap   = jarak antar garis
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/md_surface_variant" />
    <corners android:radius="16dp" />
    <stroke
        android:width="2dp"
        android:color="@color/md_outline"
        android:dashWidth="8dp"
        android:dashGap="6dp" />
</shape>
