<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        TEMA APLIKASI

        Tema = "pengaturan gaya" yang berlaku untuk SEMUA layar.
        Di sini kita memberi tahu Material 3 warna apa yang dipakai
        untuk setiap peran (primary, surface, error, dan seterusnya).

        Kita cukup punya SATU tema. Untuk mode gelap, kita tidak perlu tema
        kedua, karena semua warna di bawah mengambil dari @color/...
        dan warna-warna itu sudah punya versi gelap di values-night/colors.xml.
    -->
    <style name="Base.Theme.ATBQuickscan" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Warna brand -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <!-- Warna error sistem -->
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <!-- Warna latar belakang dan permukaan -->
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>

        <!-- Status bar (baris jam & baterai) disamakan dengan warna header.
             Header selalu berwarna gelap, jadi ikon status bar dibuat terang
             (windowLightStatusBar = false). -->
        <item name="android:statusBarColor">@color/header_background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Gaya teks: semua peran tipografi Material 3 yang kita pakai
             diarahkan ke versi yang memakai font Plus Jakarta Sans (lihat di bawah). -->
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.ATBQuickscan.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.ATBQuickscan.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.ATBQuickscan.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.ATBQuickscan.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.ATBQuickscan.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.ATBQuickscan.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.ATBQuickscan.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.ATBQuickscan.LabelLarge</item>
    </style>

    <style name="Theme.ATBQuickscan" parent="Base.Theme.ATBQuickscan" />

    <!--
        TEMA SPLASH SCREEN (LAYAR PEMBUKA)

        Tema ini hanya dipakai sesaat ketika aplikasi baru dibuka.
        - windowSplashScreenBackground   : warna latar layar pembuka
        - windowSplashScreenAnimatedIcon : ikon di tengah layar (memakai gambar ikon launcher)
        - postSplashScreenTheme          : tema yang dipakai SETELAH layar pembuka selesai

        Supaya tema ini berfungsi, MainActivity wajib memanggil installSplashScreen()
        dan AndroidManifest.xml memasang tema ini di MainActivity.
    -->
    <style name="Theme.ATBQuickscan.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/header_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ATBQuickscan</item>
    </style>

    <!--
        GAYA TEKS DENGAN FONT PLUS JAKARTA SANS

        Setiap gaya di bawah "mewarisi" (parent) gaya teks bawaan Material 3,
        jadi ukuran huruf & jarak barisnya tetap mengikuti standar Material 3.
        Yang kita ganti hanya fontnya.

        - android:fontFamily dan fontFamily ditulis dua-duanya supaya
          font terpasang di semua jenis TextView (biasa maupun AppCompat).
        - android:textFontWeight="500" = ketebalan medium, dipakai untuk judul kecil
          dan teks tombol (sesuai aturan Material 3).
    -->
    <style name="TextAppearance.ATBQuickscan.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="TextAppearance.ATBQuickscan.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="TextAppearance.ATBQuickscan.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.ATBQuickscan.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.ATBQuickscan.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="TextAppearance.ATBQuickscan.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="TextAppearance.ATBQuickscan.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="TextAppearance.ATBQuickscan.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <!--
        BENTUK SUDUT GAMBAR
        Dipakai oleh ShapeableImageView supaya sudut gambar membulat 16dp.
    -->
    <style name="ShapeAppearance.ATBQuickscan.SudutBulat" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
